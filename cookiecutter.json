{
  "project_name": "My Awesome AI API",
  "project_slug": "{{ cookiecutter.project_name.lower().replace(' ', '_').replace('-', '_') }}",
  "repo_name": "{{ cookiecutter.project_name.lower().replace(' ', '-') }}",
  "author_name": "Your Name",
  "author_email": "your.email@example.com",
  "description": "A cool AI API project generated from PydanticAI Cookiecutter.",
  "python_version": "3.12",
  "open_source_license": [
    "MIT",
    "Apache-2.0",
    "None"
  ],
  "use_mcp_server": [
    "y",
    "n"
  ],
  "use_logfire": [
    "y",
    "n"
  ],
  "api_key_env_var": "MYAPP_API_KEY",
  "default_port": 8000,
  "mcp_server_port": 3001,
  "_copy_without_render": [
      ".github/*",
      "docs/images/*"
  ]
}
