{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Open Host Terminal (Outside Container)",
            "type": "shell",
            "command": "${command:workbench.action.terminal.openNativeConsole}",
            "problemMatcher": [],
            "presentation": {
                "reveal": "never"
            },
            "detail": "Opens a terminal on the host system outside the dev container."
        },
        {
            "label": "Run Dev Server (pydanticai-api-template)",
            "type": "shell",
            "command": "pydanticai-api-template run --reload",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "detail": "Runs the FastAPI server with hot reload using the CLI.",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "runOptions": {
                "runOn": "folderOpen"
            }
        },
        {
            "label": "Lint (pydanticai-api-template)",
            "type": "shell",
            "command": "make lint",
            "group": "test",
            "problemMatcher": [
                "$ruff"
            ],
            "detail": "Runs Ruff linter and formatter checks using Make."
        },
        {
            "label": "Test (pydanticai-api-template)",
            "type": "shell",
            "command": "make test",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": [],
            "detail": "Runs pytest using Make."
        },
        {
            "label": "Validate (pydanticai-api-template)",
            "type": "shell",
            "command": "pydanticai-api-template validate",
            "problemMatcher": [],
            "detail": "Runs the CLI validation command."
        },
        {
            "label": "Cleanup (pydanticai-api-template)",
            "type": "shell",
            "command": "pydanticai-api-template cleanup",
            "problemMatcher": [],
            "detail": "Runs the CLI cleanup command."
        },
        {
            "label": "Sync Configs (pydanticai-api-template)",
            "type": "shell",
            "command": "make sync-configs",
            "problemMatcher": [],
            "detail": "Runs the configuration synchronization script."
        }
    ]
}
