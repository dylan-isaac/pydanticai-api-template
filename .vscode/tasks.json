                "lint"
            ],
            "problemMatcher": [],
            "detail": "Runs: make lint"
        },
        {
            "label": "Test",
            "type": "shell",
            "command": "make",
            "args": [
                "test"
            ],
            "problemMatcher": [],
            "detail": "Runs: make test"
        },
        {
            "label": "Validate Environment",
            "type": "shell",
            "command": "make",
            "args": [
                "validate"
            ],
            "problemMatcher": [],
            "detail": "Runs: make validate"
        },
        {
            "label": "Sync Configs",
            "type": "shell",
            "command": "make",
            "args": [
                "sync-configs"
            ],
            "problemMatcher": [],
            "detail": "Runs: make sync-configs"
        },
        {
            "label": "Install Completion",
            "type": "shell",
            "command": "make",
            "args": [
                "install-completion"
            ],
            "problemMatcher": [],
