{
  "mcpServers": {
    "pydanticai-api-template-mcp": {
      "url": "http://localhost:3001/sse"
    },
    "taskmaster-ai": {
      "command": "npx",
      "args": [
        "-y",
        "task-master-mcp"
      ],
      "env": {
        "ANTHROPIC_API_KEY": "",
        "MODEL": "claude-3-opus-20240229",
        "MAX_TOKENS": 4000,
        "DEFAULT_SUBTASKS": 5,
        "DEFAULT_PRIORITY": "medium"
      }
    }
  }
}
